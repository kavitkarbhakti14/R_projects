# Question 20 ----
# In order to determine who the MVP player would be, we need to calculate a weighted
# score using all 3 columns - OBP, HR and RBI
summary(eligible_df)
eligible_df_new <- eligible_df
# Here we notice that all 3 columns are on different scales -
# HR: Min - 0 Max - 40
# RBI: Min - 8 Max - 121
# OBP: Min - 0.2521 Max - 0.4555
# For calculating a weighted score, we need to normalize the columns to have
# the same scale
eligible_df_new$OBP_norm <- scale(eligible_df_new$OBP)
eligible_df_new$HR_norm  <- scale(eligible_df_new$HR)
eligible_df_new$RBI_norm <- scale(eligible_df_new$RBI)
# Considering equal weights for all OBP, RBI and HR
eligible_df_new$MVP <- paste((eligible_df_new$OBP_norm + eligible_df_new$HR_norm + eligible_df_new$RBI_norm) / 3)
eligible_df_new$MVP <- as.double(eligible_df_new$MVP)
mvp_player <-
eligible_df_new  %>%
arrange(desc(MVP)) %>%
select(Last, First, MVP)
mvp_player[1,]
test_file("project2_tests.R")
