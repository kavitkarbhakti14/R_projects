# clears console
cat("\014")
# clears global environment
rm(list = ls())
# clears plots
graphics.off()
# clears packages
try(p_unload(p_loaded(), character.only = TRUE), silent = TRUE)
# Libraries ----
library(tidyverse)
library(janitor)
library(testthat)
library(ggplot2)
# To see the list of packages loaded (optional)
(.packages())
# Assignment Part 1
# Question 1 ----
# Reading the data set 2015.csv
setwd("~/Kavitkar_Project2")
data_2015 <- read.csv("2015.csv")
head(data_2015)
# Question 2 ----
# Using the function names() to check column names
names(data_2015)
# Question 3 ----
# Using the view function to view the data set
# This is commented since Prof has asked to remove all view functions from the code
# view(data_2015)
# Question 4 ----
# Using the glimpse() function to view the dataset
glimpse(data_2015)
# Question 5 ----
# Cleaning the column names using clean_names() function in the janitor package
data_2015 <- clean_names(data_2015)
data_2015
# Question 6 ----
# Store country, region, happiness_score, and freedom in happy_df
happy_df <- select(data_2015,country,region,happiness_score,freedom)
happy_df
# Question 7 ----
# Slicing first 10 rows from happy_df into top_ten_df.
top_ten_df <-
happy_df %>%
arrange(desc(happiness_score)) %>%
head(10)
top_ten_df
# Question 8 ----
# Filtering happy_df for freedom values under 0.20
no_freedom_df <- filter(happy_df, freedom < 0.20)
no_freedom_df
# Question 9 ----
# Arranging record by descending order of freedom values
best_freedom_df <- arrange(happy_df, desc(freedom))
best_freedom_df
# Question 10 ----
# Calculting a new column gff_stat
data_2015$gff_stat <- paste(data_2015$family + data_2015$freedom + data_2015$generosity)
data_2015$gff_stat <- as.double(data_2015$gff_stat)
data_2015
# Question 11 ----
# Grouping the happy_df data set by region
regional_stats_df <-
happy_df %>%
group_by(region) %>%
arrange(region) %>%
summarise(
country_count = n(),
mean_happiness = mean(happiness_score),
mean_freedom = mean(freedom)
)
regional_stats_df
# Happiness score by region
ggplot(regional_stats_df, aes(x = mean_happiness,y = region)) +
geom_col(fill = "skyblue",color = "black") +
labs(title = "Region by Happiness Score",
x = "Happiness Score (Mean)",
y = "Region")
# Freedom by region
ggplot(regional_stats_df, aes(x = mean_freedom,y = region)) +
geom_col(fill = "skyblue",color = "black") +
labs(title = "Region by Freedom",
x = "Freedom (Mean)",
y = "Region")
# Assignment Part 2
# Question 12 ----
# Reading the baseball.csv file
setwd("~/Kavitkar_Project2")
baseball <- read.csv("baseball.csv")
# Question 13 ----
# Understanding the structure of the dataset
str(baseball)
summary(baseball)
names(baseball)
# Here we can see that from the above statement that First/Last Name and Age are
# qualitative columns and the rest are quantitative columns describing player
# performance
# Taking a look at the actual data
head(baseball,10)
tail(baseball,10)
# We have some stats like averages that are floating point values and others like
# number of home runs that are ratio scale integers
# Question 14 ----
# Filtering out players with 0 at bats
baseball <- filter(baseball, AB!=0)
baseball
# Question 15 ----
# Calculating batting average
baseball$BA <- paste(baseball$H / baseball$AB)
baseball$BA <- as.double(baseball$BA)
baseball
# Question 16 ----
# Calculating On-base percentage (OBP)
baseball$OBP <- paste((baseball$H+ baseball$BB) / (baseball$AB + baseball$BB))
baseball$OBP <- as.double(baseball$OBP)
baseball
# Question 17 ----
#  Determining the 10 players who struck out the most
strikeout_artist <-
baseball  %>%
arrange(desc(SO)) %>%
head(10)
strikeout_artist
# Question 18 ----
# Gathering  players having either at least 300 at
# bats or appear in at least 100 games
eligible_df <- filter(baseball, AB >= 300 | G >= 100)
eligible_df
# Question 19 ----
# Histogram of batting average
eligible_df$BA <- as.double(eligible_df$BA)
ggplot(eligible_df, aes(x = BA)) +
geom_histogram(binwidth = 0.025,
fill = "skyblue",
color = "black") +
labs(title = "Distribution of Batting Average")
# Question 20 ----
# In order to determine who the MVP player would be, we need to calculate a weighted
# score using all 3 columns - OBP, HR and RBI
eligible_df_new <- eligible_df
summary(eligible_df_new)
# Here we notice that all 3 columns are on different scales -
# HR: Min - 0 Max - 40
# RBI: Min - 8 Max - 121
# OBP: Min - 0.2521 Max - 0.4555
# For calculating a weighted score, we need to normalize the columns to have
# the same scale
eligible_df_new$OBP_norm <- scale(eligible_df_new$OBP)
eligible_df_new$HR_norm  <- scale(eligible_df_new$HR)
eligible_df_new$RBI_norm <- scale(eligible_df_new$RBI)
# Considering equal weights for all OBP, RBI and HR
eligible_df_new$MVP <- paste((eligible_df_new$OBP_norm + eligible_df_new$HR_norm + eligible_df_new$RBI_norm) / 3)
eligible_df_new$MVP <- as.double(eligible_df_new$MVP)
mvp_player <-
eligible_df_new  %>%
arrange(desc(MVP)) %>%
select(Last, First, MVP)
mvp_player[1,]
# As we can see, the top rated player according to our calculation is Mike Schmidt
test_file("project2_tests.R")
